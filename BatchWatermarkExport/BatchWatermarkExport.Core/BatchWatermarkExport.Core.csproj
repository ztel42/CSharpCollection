<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BatchWatermarkExport</RootNamespace>
    <AssemblyName>BatchWatermarkExport.Core</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fonts\LiberationSans-Regular.ttf">
      <LogicalName>BatchWatermarkExport.Fonts.LiberationSans-Regular.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
