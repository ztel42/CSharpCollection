<Window x:Class="BatchWatermarkExport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BatchWatermarkExport"
        Height="640"
        Width="720"
        MinHeight="560"
        MinWidth="640"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="BatchWatermarkExport" FontSize="22" FontWeight="SemiBold" Foreground="#1B2838"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#4A5B6C"
                       Text="Watermark a folder of stills, resize with center cover-crop (no stretch), and keep or strip EXIF. Sources are not overwritten."/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" x:Name="ExportButton" Content="Export" Height="36" Margin="0,16,0,0"
                Click="Export_Click" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Text="Ready." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#1B2838"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Input folder"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="InputBox" Margin="0,4" Padding="6,4"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Padding="12,4" Click="BrowseInput_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Output folder"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="OutputBox" Margin="0,4" Padding="6,4"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Padding="12,4" Click="BrowseOutput_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Watermark text"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="WatermarkBox" Margin="0,4" Padding="6,4" Text="© Portfolio"/>

                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Opacity"/>
                <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8">
                    <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Width="48" Text="45%" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="45" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="OpacitySlider_ValueChanged"/>
                </DockPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Position"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PositionBox" Margin="0,4" SelectedIndex="3">
                    <ComboBoxItem Content="Top left" Tag="TopLeft"/>
                    <ComboBoxItem Content="Top right" Tag="TopRight"/>
                    <ComboBoxItem Content="Bottom left" Tag="BottomLeft"/>
                    <ComboBoxItem Content="Bottom right" Tag="BottomRight"/>
                    <ComboBoxItem Content="Center" Tag="Center"/>
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Font size"/>
                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FontSizeBox" Margin="0,4" Padding="6,4" Text="0"
                         ToolTip="0 uses an automatic size based on the export height. Applied after resize."/>

                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Top" Margin="0,8,0,0" Text="Platform presets"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                    <CheckBox x:Name="CbYoutube" IsChecked="True" Content="YouTube thumbnail 1280×720" Margin="0,2"/>
                    <CheckBox x:Name="CbSquare" Content="Instagram square 1080×1080" Margin="0,2"/>
                    <CheckBox x:Name="CbPortrait" Content="Instagram portrait 1080×1350" Margin="0,2"/>
                    <CheckBox x:Name="CbFull" Content="Full-res portfolio (original pixel size)" Margin="0,2"/>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Top" Margin="0,8,0,0" Text="EXIF"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                    <RadioButton x:Name="RbStrip" GroupName="Exif" IsChecked="True" Content="Strip EXIF (also drops XMP and IPTC)" Margin="0,2"/>
                    <RadioButton x:Name="RbKeep" GroupName="Exif" Content="Keep EXIF that ImageSharp can copy" Margin="0,2"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
